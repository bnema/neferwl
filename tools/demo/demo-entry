#!/bin/sh
# Starts the session bus shared by the compositor and the apps, turns
# accessibility on before any app starts, then runs the compositor as the
# container's main process: the container exits with it.
set -eu
dbus-daemon --session --fork --address="$DBUS_SESSION_BUS_ADDRESS"
dbus-send --session --print-reply --dest=org.a11y.Bus /org/a11y/bus \
    org.freedesktop.DBus.Properties.Set string:org.a11y.Status string:IsEnabled variant:boolean:true >/dev/null
exec /usr/local/bin/neferwl "$@"
