# NeferWL · a little space to think
animations = on
layout.gaps = 0
layout.max-columns = 2
layout.overflow = cascade
border.width = 2
border.active = #ffc799
border.inactive = #282828
background = #101010
terminal.auto-open = off
stash.spawn-terminal = off
stash.capture = off
keyboard.layout = us

# Columns fill a band; extra windows flow below.
# Super+Up / Down travel between bands.
# Super+Shift+s sets a window aside.
# Super+s brings your stash into view.
# Super+o opens the overview.
bind.cmd+code:3 = focus-workspace 2
bind.cmd+code:2 = focus-workspace 1

# Warm up btop off-screen before bringing its real samples into band 2.
rule.monitor.app-id = demo-monitor
rule.monitor.workspace = 2
