#!/usr/bin/env python3
"""Print the hint label of the link under a word of the last hint scan.

usage: demo-hint-label <since-epoch> <word>...

Waits for a hint dump (NEFERWL_HINT_DEBUG=1) written after <since-epoch>, reads
the scanned frame with tesseract, finds the largest occurrence of the first of
the words that is on screen and returns the label of the link target under it.
Labels follow internal/core/hint.go: targets sorted by top then left edge, one
letter each from the home-row alphabet, two letters past 26 targets.
"""
import csv, glob, io, json, os, re, subprocess, sys, time

ALPHABET = "fjdkslaghrueiwoqptyvbcnxmz"
DUMPS = os.path.join(os.environ.get("XDG_STATE_HOME", "/work/state"), "neferwl", "hints")


def newest_dump(since):
    deadline = time.time() + 15
    while time.time() < deadline:
        for path in sorted(glob.glob(os.path.join(DUMPS, "*.json")), reverse=True):
            png = path[:-5] + ".png"
            if os.path.getmtime(path) >= since and os.path.exists(png):
                return path, png
        time.sleep(0.2)
    sys.exit("no hint scan dump after the bind")


def words(png):
    out = subprocess.run(["tesseract", png, "stdout", "--psm", "11", "tsv"],
                         capture_output=True, text=True, check=True).stdout
    for row in csv.DictReader(io.StringIO(out), delimiter="\t", quoting=csv.QUOTE_NONE):
        text = re.sub(r"\W", "", row["text"] or "").lower()
        if text and float(row["conf"]) > 30:
            x, y, w, h = (int(row[k]) for k in ("left", "top", "width", "height"))
            yield text, x + w / 2, y + h / 2, h


def main():
    since, wanted = float(sys.argv[1]), [w.lower() for w in sys.argv[2:]]
    path, png = newest_dump(since)
    meta = json.load(open(path))
    # Core keeps the targets whose centre is on the output, then sorts them.
    width, height = meta["width"], meta["height"]
    targets = [t for t in meta["targets"]
               if 0 <= (t["rect"][0] + t["rect"][2]) / 2 < width and 0 <= (t["rect"][1] + t["rect"][3]) / 2 < height]
    targets.sort(key=lambda t: (t["rect"][1], t["rect"][0]))
    found = list(words(png))
    for word in wanted:
        hits = [(h, cx, cy) for t, cx, cy, h in found if t == word]
        for _, cx, cy in sorted(hits, reverse=True):
            for i, t in enumerate(targets):
                x0, y0, x1, y1 = t["rect"]
                if t["kind"] == "link" and x0 <= cx < x1 and y0 <= cy < y1:
                    n = len(ALPHABET)
                    print(ALPHABET[i] if len(targets) <= n else ALPHABET[i // n] + ALPHABET[i % n])
                    return
    sys.exit("none of %s is under a link target (%d targets)" % (wanted, len(targets)))


main()
