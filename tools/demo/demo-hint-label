#!/usr/bin/env python3
"""Work out the hint label of a link, to type it the way a user reads it.

  demo-hint-label ocr
      Reads the frame on screen now (the compositor's latest screenshot) with
      tesseract and keeps the words and their boxes in /tmp/hint-words.json.
      Run it while the page is still, before the hint bind, so that the
      lookup after the bind needs no OCR.

  demo-hint-label label <since-epoch> <word>...
      Waits for the hint dump (NEFERWL_HINT_DEBUG=1) of the scan started after
      <since-epoch>, finds the link target that shows all the words and prints
      its label. Labels follow internal/core/hint.go: the targets whose centre
      is on the output, sorted by top then left edge, one letter each from the
      home-row alphabet, two letters past 26 targets.
"""
import csv, glob, io, json, os, re, shutil, subprocess, sys, time

ALPHABET = "fjdkslaghrueiwoqptyvbcnxmz"
STATE = os.environ.get("XDG_STATE_HOME", "/work/state")
DUMPS = os.path.join(STATE, "neferwl", "hints")
SHOT = "/work/shots/latest.png"
WORDS = "/tmp/hint-words.json"


def ocr():
    shutil.copyfile(SHOT, "/tmp/hint-ocr.png")
    out = subprocess.run(["tesseract", "/tmp/hint-ocr.png", "stdout", "--psm", "11", "tsv"],
                         capture_output=True, text=True, check=True).stdout
    words = []
    for row in csv.DictReader(io.StringIO(out), delimiter="\t", quoting=csv.QUOTE_NONE):
        text = re.sub(r"\W", "", row["text"] or "").lower()
        if text and float(row["conf"]) > 30:
            x, y, w, h = (int(row[k]) for k in ("left", "top", "width", "height"))
            words.append([text, x + w / 2, y + h / 2])
    json.dump(words, open(WORDS, "w"))


def newest_dump(since):
    deadline = time.time() + 15
    while time.time() < deadline:
        for path in sorted(glob.glob(os.path.join(DUMPS, "*.json")), reverse=True):
            if os.path.getmtime(path) >= since:
                return path
        time.sleep(0.05)
    sys.exit("no hint scan dump after the bind")


def label(since, wanted):
    meta = json.load(open(newest_dump(since)))
    words = json.load(open(WORDS))
    # Core keeps the targets whose centre is on the output, then sorts them.
    width, height = meta["width"], meta["height"]
    targets = [t for t in meta["targets"]
               if 0 <= (t["rect"][0] + t["rect"][2]) / 2 < width and 0 <= (t["rect"][1] + t["rect"][3]) / 2 < height]
    targets.sort(key=lambda t: (t["rect"][1], t["rect"][0]))
    for i, t in enumerate(targets):
        x0, y0, x1, y1 = t["rect"]
        inside = {w for w, cx, cy in words if x0 <= cx < x1 and y0 <= cy < y1}
        if t["kind"] == "link" and set(wanted) <= inside:
            n = len(ALPHABET)
            print("link %d of %d shows %s" % (i + 1, len(targets), " ".join(wanted)), file=sys.stderr)
            print(ALPHABET[i] if len(targets) <= n else ALPHABET[i // n] + ALPHABET[i % n])
            return
    sys.exit("no link shows %s (%d targets, %d words read)" % (" ".join(wanted), len(targets), len(words)))


if sys.argv[1:2] == ["ocr"]:
    ocr()
elif sys.argv[1:2] == ["label"] and len(sys.argv) > 3:
    label(float(sys.argv[2]), [w.lower() for w in sys.argv[3:]])
else:
    sys.exit(__doc__)
