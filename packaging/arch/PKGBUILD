# Built by `make pkg` at the repo root, from the `make dist` tarball.
pkgname=nefertty
pkgver=0.0.0
pkgrel=1
pkgdesc='Minimal Wayland compositor with scrollable columns, for the TTY'
arch=('x86_64')
url='https://github.com/bnema/nefertty'
license=('MIT')
# Loaded at runtime (purego, no cgo): not seen by makepkg's library scan.
depends=('glibc' 'libinput' 'libxkbcommon' 'seatd' 'systemd-libs' 'vulkan-icd-loader'
	'vulkan-driver' 'wayland' 'dbus')
makedepends=('go')
optdepends=('xwayland-satellite>=0.7: X11 apps'
	'foot: default terminal'
	'fuzzel: launcher'
	'xdg-desktop-portal-gtk: file pickers and settings for apps')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0 GOFLAGS='-mod=vendor -trimpath -buildvcs=false -buildmode=pie' GOPROXY=off GOTOOLCHAIN=local
	go build -ldflags "-X main.version=$pkgver" -o nefertty ./cmd/nefertty
}

check() {
	cd "$pkgname-$pkgver"
	./nefertty version
	./nefertty validate-config examples/config
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 nefertty "$pkgdir/usr/bin/nefertty"
	install -Dm644 packaging/nefertty.desktop "$pkgdir/usr/share/wayland-sessions/nefertty.desktop"
	install -Dm644 packaging/nefertty-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/nefertty-portals.conf"
	install -Dm644 examples/config "$pkgdir/usr/share/doc/nefertty/config.example"
	install -Dm644 README.md "$pkgdir/usr/share/doc/nefertty/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/nefertty/LICENSE"
}
