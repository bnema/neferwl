# nefertty config: one `key = value` per line, # starts a comment.
# Every value below is the default; a missing file means defaults.
# Changes apply live. An invalid line logs a warning and keeps the default.

# Keyboard (xkb names, e.g. layout = fr, options = caps:escape).
keyboard.layout =
keyboard.variant =
keyboard.options =
keyboard.repeat-rate = 25
keyboard.repeat-delay = 600
# Which modifier `cmd` means in binds: super, alt or ctrl.
keyboard.cmd = super

# Command for spawn-terminal and the terminal opened at startup.
terminal = foot

background = #111111

# Drawn inside the window edge; width 0 disables it, empty inactive draws nothing.
border.width = 2
border.active = #b4befe
border.inactive =

layout.gaps = 0
# Columns sharing the screen equally before new ones scroll off to the right.
# A lone column fills the screen without a border.
layout.max-columns = 2
# Past max-columns: scroll opens columns to the right; fixed keeps everything
# on screen, each new window splitting the newest one (spiral).
layout.overflow = scroll
# cycle-column-width steps through these, then back to the equal share.
layout.presets = 1/3, 1/2, 2/3, 1

# Named workspaces. Numbered at their place like any other and never removed
# when empty. hidden = on keeps one out of the numbers and of up/down: only its
# bind shows it, and pressing the bind again returns to the previous workspace.
# max-columns and overflow override the layout.* values.
# workspace.dev.hidden = on
# workspace.dev.max-columns = 3
# workspace.dev.overflow = fixed
# bind.cmd+d = workspace dev
#
# Slots: column.N = <width>, <command>. nefertty starts each command in the
# background and puts its first window in column N, without taking focus.
# A closed slot stays empty until the workspace is shown again. Apps that
# reuse a running instance need a new-instance flag.
# workspace.dev.column.1 = 67%, code --new-window
# workspace.dev.column.2 = 33%, foot

# Displays (drm backend): WxH, WxH@Hz, preferred or off.
# The first listed display that is connected and not off is used.
# output.DP-2 = 5120x2160@165.058
# output.HDMI-A-1 = off
# Scale (HiDPI), 1 to 4, like 1.5 or 4/3. Default 1. scale-up and scale-down
# step through the scales where the display divides into whole pixels.
# output.DP-2.scale = 4/3

render.direct-scanout = on

# log.level: debug, info, warn or error. log.debug: components or all.
log.level = info
log.debug =

# Binds: bind.<keys> = <action>. Modifiers: cmd, shift, ctrl, alt, super.
# code:N is a physical key (evdev code), the same key on every layout:
# code:2 to code:10 are the digit row 1 to 9, code:12 and code:13 the two
# keys right of 0 (- and = on US).
# Keys are what your layout prints (cmd+é on AZERTY). Write = # and space
# by name: cmd+equal, cmd+numbersign, cmd+space. `none` removes a default.
# `spawn <command>` runs a program; arguments split on spaces, no shell.
bind.cmd+return = spawn-terminal
bind.cmd+left = focus-column-left
bind.cmd+right = focus-column-right
bind.cmd+up = focus-window-up
bind.cmd+down = focus-window-down
bind.cmd+shift+left = move-column-left
bind.cmd+shift+right = move-column-right
bind.cmd+r = cycle-column-width
bind.cmd+shift+f = toggle-fullscreen
bind.cmd+q = close-window
bind.ctrl+alt+backspace = quit
bind.ctrl+cmd+space = spawn fuzzel

# Workspaces stack vertically; numbers follow their order. An empty one always
# waits below the last. cmd+up/down past the column edge also switch workspace.
bind.cmd+pageup = focus-workspace-up
bind.cmd+pagedown = focus-workspace-down
bind.cmd+shift+pageup = move-to-workspace-up
bind.cmd+shift+pagedown = move-to-workspace-down
bind.cmd+code:2 = focus-workspace 1
bind.cmd+code:3 = focus-workspace 2
bind.cmd+code:4 = focus-workspace 3
bind.cmd+code:5 = focus-workspace 4
bind.cmd+code:6 = focus-workspace 5
bind.cmd+code:7 = focus-workspace 6
bind.cmd+code:8 = focus-workspace 7
bind.cmd+code:9 = focus-workspace 8
bind.cmd+code:10 = focus-workspace 9
bind.cmd+shift+code:2 = move-to-workspace 1
bind.cmd+shift+code:3 = move-to-workspace 2
bind.cmd+shift+code:4 = move-to-workspace 3
bind.cmd+shift+code:5 = move-to-workspace 4
bind.cmd+shift+code:6 = move-to-workspace 5
bind.cmd+shift+code:7 = move-to-workspace 6
bind.cmd+shift+code:8 = move-to-workspace 7
bind.cmd+shift+code:9 = move-to-workspace 8
bind.cmd+shift+code:10 = move-to-workspace 9

# Zoom: the whole display, live.
bind.cmd+code:13 = scale-up
bind.cmd+code:12 = scale-down
